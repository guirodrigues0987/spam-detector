# Copy to .env and adjust. Never commit the real .env.
DATA_DIR=data
ARTIFACTS_DIR=artifacts
RANDOM_SEED=42
# Probability above which a message is classified as spam
SPAM_THRESHOLD=0.5
LOG_LEVEL=INFO
# Serve Prometheus metrics on this separate port (unset = no metrics server).
# docker-compose.yml already sets 9100 for the container.
METRICS_PORT=
# Grafana admin password for the local monitoring stack (default: admin)
GRAFANA_ADMIN_PASSWORD=
